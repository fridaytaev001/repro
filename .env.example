# Copy to .env and enter the key locally. Do not paste secrets into chat.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Exact Nemotron 3 Super ID verified against the live Crusoe catalog.
CRUSOE_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
REPRO_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
REPRO_TARGET_URL=http://127.0.0.1:8000/
